# URL pública do site, sem barra no fim (usada em metadados, OG, sitemap e referências).
# Na Vercel, sem esta variável, vale o domínio de produção do projeto
# (NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL, exposta automaticamente).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mural Cultural
# Conteúdo de demonstração (demo: true): aparece em desenvolvimento e fica oculto em produção.
# MURAL_DEMO=1 mostra em qualquer ambiente (ex.: preview da Vercel); MURAL_DEMO=0 esconde sempre.
MURAL_DEMO=
# Para onde vão as inscrições da chamada aberta (POST com JSON): Google Apps Script,
# Formspree, Make, Zapier, n8n, Discord ou Slack. Sem ela, produção responde "abre em breve".
MURAL_INSCRICOES_WEBHOOK_URL=

# Modal Participe, caminho "Produzir conteúdo": para onde vão os contatos (POST com JSON).
# Sem ela, produção responde "abre em breve". O caminho de artista usa MURAL_INSCRICOES_WEBHOOK_URL.
CONTEUDO_CONTATOS_WEBHOOK_URL=
